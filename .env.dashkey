# ============================================================================
# CONFIGURATION DASHKEY.FR - API HTTPS
# ============================================================================
# Ce fichier contient votre configuration pour dashkey.fr
# Renommez ce fichier en .env une fois vos certificats installés
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
DOMAIN=dashkey.fr

# ============================================================================
# SSL/TLS CONFIGURATION - CERTIFICATS DASHKEY
# ============================================================================
# ⚠️ IMPORTANT : Placez d'abord vos certificats dans /workspace/ssl/
# Voir le guide : INSTALLER-CERTIFICATS-DASHKEY.md

SSL_KEY_PATH=/workspace/ssl/API.Dashkey.key
SSL_CERT_PATH=/workspace/ssl/API.Dashkey.Sign.crt
SSL_CA_PATH=/workspace/ssl/CA_DASHKEY.crt

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Domaines autorisés à accéder à votre API
# Séparez plusieurs origines par des virgules
ALLOWED_ORIGINS=https://dashkey.fr,https://www.dashkey.fr,https://app.dashkey.fr

# ============================================================================
# MYSQL DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=votre-utilisateur-mysql
DB_PASSWORD=votre-mot-de-passe-mysql
DB_NAME=Dashkey_test

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# ⚠️ CRITIQUE : Changez cette clé secrète (minimum 32 caractères)
# Générez une clé aléatoire avec :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=CHANGEZ-MOI-cle-secrete-minimum-32-caracteres-aleatoire
JWT_EXPIRES_IN=7d

# ============================================================================
# SECURITY
# ============================================================================
# Si derrière Nginx ou autre reverse proxy : 1
# Si accès direct sans proxy : 0
TRUST_PROXY=1

# ============================================================================
# NOTES
# ============================================================================
# 1. Installez vos certificats dans /workspace/ssl/ (voir guide)
# 2. Configurez Nginx comme reverse proxy (recommandé)
# 3. Générez un nouveau JWT_SECRET
# 4. Configurez vos identifiants MySQL
# 5. Renommez ce fichier en .env
# 6. Démarrez : node server.js

# ============================================================================
# CONFIGURATION DASHKEY.FR - PRODUCTION
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000

# ⚠️ IMPORTANT : Pour être accessible par Nginx/Proxy depuis l'extérieur
# Utilisez 0.0.0.0 pour écouter sur toutes les interfaces
# Ou l'IP spécifique de votre interface réseau (ex: 192.168.105.X)
HOST=0.0.0.0

NODE_ENV=production
DOMAIN=dashkey.fr

# ============================================================================
# SSL/TLS CONFIGURATION (HTTPS)
# ============================================================================
SSL_KEY_PATH=/etc/ssl/private/API.Dashkey.key
SSL_CERT_PATH=/home/API.Dashkey.Sign.crt
SSL_CA_PATH=/home/CA_DASHKEY.crt

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# ⚠️ IMPORTANT : 
# - Le port 30443 est le port EXTERNE du proxy (ce que voit le client)
# - Votre API écoute sur le port 3000 en INTERNE
# - Ajoutez toutes les origines nécessaires
ALLOWED_ORIGINS=https://dashkey.fr:30443,https://dashkey.fr,https://www.dashkey.fr,https://api.dashkey.fr

# ============================================================================
# MYSQL DATABASE CONFIGURATION
# ============================================================================
DB_HOST=192.168.105.3
DB_PORT=3306
DB_USER=API
DB_PASSWORD='G7!k9#vR2qX$u8LmZ4tPf3Y'
DB_NAME=Dashkey_test

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_SECRET='YEZUUKXlcujXfJH9x/8AoEb5BtBfULyjAZdc4cV6wtj9p8A3LMujw9Y+czGvF3vGIvlthfQxe37RBmi6ZsZT3w=='
JWT_EXPIRES_IN=30d

# ============================================================================
# SECURITY & PROXY
# ============================================================================
# Si derrière Nginx/Proxy, mettez 1 (pour récupérer la vraie IP des clients)
TRUST_PROXY=1

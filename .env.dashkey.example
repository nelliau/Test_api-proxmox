# ============================================================================
# CONFIGURATION POUR DASHKEY.FR (PRODUCTION)
# ============================================================================
# Copiez ce fichier en .env sur votre VM et ajustez les valeurs

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
DOMAIN=dashkey.fr

# ============================================================================
# SSL/TLS CONFIGURATION (HTTPS) - Certificats Dashkey existants
# ============================================================================
SSL_KEY_PATH=/etc/ssl/private/API.Dashkey.key
SSL_CERT_PATH=/home/API.Dashkey.Sign.crt
SSL_CA_PATH=/home/CA_DASHKEY.crt

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# ⚠️ IMPORTANT : Utilisez https:// pour HTTPS
# Listez tous vos domaines/sous-domaines séparés par des virgules
ALLOWED_ORIGINS=https://dashkey.fr,https://www.dashkey.fr,https://api.dashkey.fr

# ============================================================================
# MYSQL DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=votre-utilisateur
DB_PASSWORD=votre-mot-de-passe-securise
DB_NAME=Dashkey_test

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# ⚠️ IMPORTANT : Générez une clé secrète forte (minimum 32 caractères)
# Commande : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGEZ-MOI-cle-secrete-minimum-32-caracteres-aleatoire
JWT_EXPIRES_IN=7d

# ============================================================================
# SECURITY
# ============================================================================
# Si derrière un reverse proxy (Nginx/Apache), mettez 1
# Si accès direct, mettez 0
TRUST_PROXY=1

# Server Configuration
PORT=3000
HOST=127.0.0.1  # Internal only (localhost) - Change to 0.0.0.0 for external access
NODE_ENV=development

# SSL/TLS Configuration (Optional - for HTTPS)
# Leave empty to use HTTP, or provide paths to SSL certificates for HTTPS
# For internal HTTPS, use self-signed certificate (see generate-ssl-cert.sh)
SSL_KEY_PATH=./ssl/private.key
SSL_CERT_PATH=./ssl/certificate.crt
# SSL_CA_PATH=/path/to/ca_bundle.crt  # Optional: certificate chain

# MySQL Database Configuration
DB_HOST=votre-serveur-mysql.local
DB_PORT=3306
DB_USER=votre-utilisateur
DB_PASSWORD=votre-mot-de-passe
DB_NAME=Dashkey_test

# JWT Authentication
# IMPORTANT: Changez cette clé secrète en production (générez une clé aléatoire longue)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre-cle-secrete-tres-longue-et-aleatoire-a-changer
JWT_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

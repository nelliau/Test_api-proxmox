# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# ============================================================================
# SSL/TLS CONFIGURATION (HTTPS)
# ============================================================================
# Laissez vide pour HTTP, remplissez pour activer HTTPS
# Développement: utilisez ./ssl/server.key et ./ssl/server.cert (auto-signés)
# Production: utilisez Let's Encrypt (/etc/letsencrypt/live/votre-domaine/)

# SSL_KEY_PATH=./ssl/server.key
# SSL_CERT_PATH=./ssl/server.cert
# SSL_CA_PATH=./ssl/ca-bundle.crt  # Optionnel (chaîne de certificats)

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Adaptez selon votre protocole (http:// ou https://)
# Séparez plusieurs origines par des virgules
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# MYSQL DATABASE CONFIGURATION
# ============================================================================
DB_HOST=votre-serveur-mysql.local
DB_PORT=3306
DB_USER=votre-utilisateur
DB_PASSWORD=votre-mot-de-passe
DB_NAME=Dashkey_test

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# IMPORTANT: Changez cette clé secrète en production (minimum 32 caractères)
# Générez-en une avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre-cle-secrete-tres-longue-et-aleatoire-a-changer-minimum-32-caracteres
JWT_EXPIRES_IN=7d

# ============================================================================
# SECURITY
# ============================================================================
# Nombre de proxies de confiance (0 = direct, 1 = derrière 1 proxy, etc.)
TRUST_PROXY=0

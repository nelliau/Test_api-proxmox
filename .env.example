# Server Configuration
PORT=3000

# SSL/TLS Configuration (HTTPS) - Optionnel
# Décommentez et configurez pour activer HTTPS
# Pour générer des certificats auto-signés: ./generate-ssl.sh
#SSL_KEY_PATH=/workspace/ssl/key.pem
#SSL_CERT_PATH=/workspace/ssl/cert.pem
#SSL_CA_PATH=/workspace/ssl/chain.pem

# MySQL Database Configuration
DB_HOST=votre-serveur-mysql.local
DB_PORT=3306
DB_USER=votre-utilisateur
DB_PASSWORD=votre-mot-de-passe
DB_NAME=Dashkey_test

# JWT Authentication
# IMPORTANT: Changez cette clé secrète en production (générez une clé aléatoire longue)
JWT_SECRET=votre-cle-secrete-tres-longue-et-aleatoire-a-changer
JWT_EXPIRES_IN=7d

# CORS Configuration
# Liste des domaines autorisés séparés par des virgules
# Exemple: ALLOWED_ORIGINS=https://monsite.com,https://app.monsite.com
#ALLOWED_ORIGINS=http://localhost:3000

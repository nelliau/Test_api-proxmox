# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=votre-serveur-mysql.local
DB_PORT=3306
DB_USER=votre-utilisateur
DB_PASSWORD=votre-mot-de-passe
DB_NAME=Dashkey_test

# JWT Authentication
# IMPORTANT: Changez cette clé secrète en production (générez une clé aléatoire longue)
# Générez une clé avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=votre-cle-secrete-tres-longue-et-aleatoire-a-changer
JWT_EXPIRES_IN=7d

# SSL/HTTPS Configuration (optionnel)
# Décommentez et configurez ces variables pour activer HTTPS
# SSL_KEY_PATH=/path/to/private-key.pem
# SSL_CERT_PATH=/path/to/certificate.pem
# SSL_CA_PATH=/path/to/ca-bundle.pem

# Security Configuration
# Liste des origines autorisées pour CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Nombre de proxies entre le serveur et l'utilisateur (0 si accès direct)
TRUST_PROXY=0

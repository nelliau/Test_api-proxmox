# Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# SSL/HTTPS Configuration (optionnel)
# Pour activer HTTPS, décommentez et configurez ces variables :
# SSL_KEY_PATH=/chemin/vers/votre/private.key
# SSL_CERT_PATH=/chemin/vers/votre/certificate.crt
# SSL_CA_PATH=/chemin/vers/votre/ca_bundle.crt  # Optionnel : chaîne de certificats

# MySQL Database Configuration
DB_HOST=votre-serveur-mysql.local
DB_PORT=3306
DB_USER=votre-utilisateur
DB_PASSWORD=votre-mot-de-passe
DB_NAME=Dashkey_test

# JWT Authentication
# IMPORTANT: Changez cette clé secrète en production (générez une clé aléatoire longue)
JWT_SECRET=votre-cle-secrete-tres-longue-et-aleatoire-a-changer
JWT_EXPIRES_IN=7d

# CORS Configuration
# ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com
